{
  "name": "@formulavize/lang-fiz",
  "version": "2.3.3",
  "description": "fiz language support for CodeMirror",
  "scripts": {
    "prepack": "run-s build test",
    "build": "cm-buildhelper src/index.ts",
    "test": "mocha test/test-*.js",
    "format": "prettier --write .",
    "dev:watch": "chokidar '{src,test}/**/*.ts' -c 'pnpm run all'",
    "all": "run-s build test"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@formulavize/lezer-fiz": "^2.3.3"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "^1.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@lezer/common": "^1.5.5",
    "chokidar-cli": "^3.0.0",
    "ist": "^1.1.7",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formulavize/lang-fiz.git"
  },
  "author": "anthologen",
  "license": "MIT",
  "homepage": "https://github.com/formulavize/lang-fiz#readme"
}
